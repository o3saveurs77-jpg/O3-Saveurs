// Ô 3 Saveurs — Chez Laila · schéma de données
//
// Production : PostgreSQL (Neon). Neon fournit deux URLs : une "pooled"
// (…-pooler…, PgBouncer) pour l'app (DATABASE_URL) et une "direct" pour les
// migrations (DIRECT_URL).
//
// Conventions
// ───────────
// · **Tous les montants sont des entiers de centimes** (`…Cents`). Jamais de
//   Float pour de l'argent : 3 × 3,99 € donne 11.969999… en flottant, ce qui
//   fait diverger la comptabilité des relevés Stripe. Voir `lib/money.ts`.
// · Les colonnes suffixées `Json` sont du JSON sérialisé en TEXT (héritage
//   SQLite). `lib/serialize.ts` les parse avec repli.
// · Les statuts sont des `String` validés par des unions TypeScript dans
//   `lib/types.ts`, pas des enums Prisma, pour éviter une migration à chaque
//   nouvelle valeur métier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Catalogue ────────────────────────────────────────────────

model Category {
  slug     String  @id
  label    String
  script   String
  position Int     @default(0)
  active   Boolean @default(true)

  @@index([position])
}

model Dish {
  id        String  @id @default(cuid())
  cat       String
  name      String
  desc      String  @default("")
  /// null = prix à définir / « bientôt »
  priceCents Int?
  photo     String?
  /// Healthy | Nouveau | Bientôt | Coup de cœur
  badge     String?
  popular   Boolean @default(false)
  /// Disponibilité manuelle. Le stock à 0 rend le plat indisponible de fait.
  available Boolean @default(true)
  spice     Int     @default(0)

  /// JSON: string[]
  tags     String  @default("[]")
  /// JSON: DishOption[]
  options  String  @default("[]")
  /// JSON: [string, number][] — formules d'upsell, prix en centimes
  formules String?
  /// JSON: Allergen[] — 14 allergènes réglementaires (INCO 1169/2011)
  allergens String @default("[]")

  /// null = stock illimité (plat toujours disponible)
  stock      Int?
  /// seuil d'alerte de réapprovisionnement
  stockAlert Int?
  /// coût matière, pour le calcul de marge du tableau de bord
  costCents  Int?

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  specials  DailySpecial[]
  formulaChoices FormulaChoice[]

  @@index([cat, position])
  @@index([available])
}

// ─── Formules ─────────────────────────────────────────────────
// Une formule n'est pas un plat : c'est un prix fixe et une composition
// (« entrée + plat + dessert »). Chaque créneau porte la liste des plats que
// la cliente accepte à cet endroit-là, ce qui rend la formule pilotable depuis
// le back-office sans toucher au code. Le prix facturé reste calculé par le
// serveur : prix de la formule + suppléments des plats choisis.

model Formula {
  id String @id @default(cuid())
  /// pastille courte affichée sur la carte : F1, F2…
  code String @unique
  name String
  desc String @default("")
  /// argument secondaire, affiché sous le prix (« Sur le pouce »)
  extra      String  @default("")
  priceCents Int
  active     Boolean @default(true)
  position   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots FormulaSlot[]

  @@index([active, position])
}

model FormulaSlot {
  id        String  @id @default(cuid())
  formulaId String
  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  /// « Votre entrée », « Votre plat »…
  label String
  /// un créneau facultatif peut rester vide (supplément offert, boisson…)
  required Boolean @default(true)
  position Int     @default(0)

  choices FormulaChoice[]

  @@index([formulaId, position])
}

model FormulaChoice {
  id     String      @id @default(cuid())
  slotId String
  slot   FormulaSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  dishId String
  dish   Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  /// supplément en centimes (Thiéboudiène Poisson +4 €, poisson entier +9 €)
  supplementCents Int @default(0)
  position        Int @default(0)

  @@unique([slotId, dishId])
  @@index([slotId, position])
}

model StockMovement {
  id     String @id @default(cuid())
  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  /// négatif = sortie (vente, perte), positif = entrée (réappro, correction)
  delta  Int
  /// vente | reappro | correction | perte | inventaire
  reason String
  note   String?
  /// email de l'auteur (null = automatique, déclenché par une commande)
  author String?
  /// commande à l'origine du mouvement, le cas échéant
  orderId   String?
  createdAt DateTime @default(now())

  @@index([dishId, createdAt])
  @@index([createdAt])
}

// ─── Livraison ────────────────────────────────────────────────

model Zone {
  id           String  @id @default(cuid())
  idx          Int     @unique
  feeCents     Int
  minimumCents Int
  /// JSON: string[] — noms de communes
  cities       String
  /// JSON: string[] — codes postaux, clé de rapprochement fiable
  zips         String  @default("[]")
  active       Boolean @default(true)
}

/// Barème de livraison à la distance — remplace le rapprochement par code
/// postal quand `delivery.mode` vaut « distance ». Une commune ne dit rien du
/// trajet réel : deux adresses du même code postal peuvent être à 2 et 9 km.
///
/// Les paliers sont bornés par le haut et évalués du plus petit au plus grand :
/// une distance tombe dans le premier palier dont `maxKm` la couvre. Au-delà du
/// dernier palier, on ne livre pas.
model DeliveryTier {
  id           String  @id @default(cuid())
  idx          Int     @unique
  /// borne haute **incluse**, en kilomètres de route (pas à vol d'oiseau)
  maxKm        Float
  feeCents     Int
  minimumCents Int
  active       Boolean @default(true)

  @@index([idx])
}

model OpeningHours {
  /// 0 = dimanche … 6 = samedi
  weekday Int     @id
  closed  Boolean @default(false)
  /// service du midi, format "11:30" (null = pas de service)
  lunchOpen   String?
  lunchClose  String?
  /// service du soir
  dinnerOpen  String?
  dinnerClose String?
}

model Driver {
  id      String  @id @default(cuid())
  name    String
  phone   String  @default("")
  vehicle String?
  active  Boolean @default(true)

  /// Email du compte Auth0 du livreur, s'il en a un.
  ///
  /// C'est le seul lien entre une session et une fiche livreur : un compte
  /// portant le rôle LIVREUR retrouve ses tournées par cette adresse. Reste
  /// facultatif — un extra livre très bien avec le lien privé, sans compte.
  email String? @unique

  createdAt DateTime @default(now())
  runs      DeliveryRun[]
  orders    Order[]
}

/// Tournée : un livreur, un créneau, plusieurs commandes ordonnées.
model DeliveryRun {
  id       String  @id @default(cuid())
  driverId String
  driver   Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  /// jour de la tournée (à minuit, Europe/Paris)
  date     DateTime
  slot     String  @default("asap")
  /// preparee | en_cours | terminee | annulee
  status   String  @default("preparee")
  notes    String?

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  /// Jeton du lien privé remis au livreur (`/tournee/<jeton>`).
  ///
  /// Le livreur n'a pas de compte : il reçoit un lien par SMS et l'ouvre sur
  /// son téléphone, ce qui permet de faire rouler un extra embauché le matin
  /// même. Ce lien donne accès aux adresses et téléphones de la tournée : il
  /// expire donc (`accessExpiresAt`) et peut être révoqué en le régénérant.
  accessToken     String?   @unique
  accessExpiresAt DateTime?

  orders Order[]

  @@index([date, status])
  @@index([driverId, date])
}

// ─── Mise en avant ────────────────────────────────────────────

model DailySpecial {
  id         String  @id @default(cuid())
  /// plat du catalogue mis en avant (null = plat libre, décrit par `name`)
  dishId     String?
  dish       Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)
  name       String
  priceCents Int?
  /// récurrence hebdomadaire : 0 = dimanche … 6 = samedi (null si `date` est fixé)
  weekday    Int?
  /// date précise, prioritaire sur `weekday`
  date       DateTime?
  active     Boolean @default(true)
  position   Int     @default(0)

  @@index([weekday])
  @@index([date])
}

/// Bandeau d'information en haut du site (« Fermé le 15 août », « Nouveau : … »).
model Announcement {
  id       String    @id @default(cuid())
  message  String
  link     String?
  /// info | promo | alerte
  tone     String    @default("info")
  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean   @default(true)
  position Int       @default(0)

  createdAt DateTime @default(now())
}

/// Encart publicitaire / visuel de mise en avant.
model Banner {
  id    String  @id @default(cuid())
  title String
  image String
  link  String?
  /// accueil | carte | panier
  placement String  @default("accueil")
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean @default(true)
  position  Int     @default(0)
  /// compteur de clics, pour mesurer l'efficacité
  clicks    Int     @default(0)

  createdAt DateTime @default(now())
}

// ─── Promotions ───────────────────────────────────────────────

model Promotion {
  id    String  @id @default(cuid())
  /// null pour une promotion automatique (sans code à saisir)
  code  String? @unique
  label String
  /// percent | amount | free_delivery
  kind  String
  /// pourcentage 1-100 si kind=percent, centimes si kind=amount, ignoré si free_delivery
  value Int     @default(0)

  minSubtotalCents Int @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  /// null = illimité
  maxUses          Int?
  usedCount        Int     @default(0)
  oncePerCustomer  Boolean @default(false)
  /// restreint à un jour de la semaine (0 = dimanche), null = tous les jours
  weekday          Int?
  /// true = appliquée automatiquement sans que le client saisisse un code
  auto             Boolean @default(false)
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  orders    Order[]

  @@index([active, auto])
}

// ─── Clients & commandes ──────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String  @default("")
  /// hash bcrypt (null = compte invité / OAuth)
  password String?
  /// CLIENT | ADMIN
  role     String  @default("CLIENT")
  /// JSON: dishIds[]
  favorites String @default("[]")
  /// JSON: SavedAddress[]
  addresses String @default("[]")

  createdAt DateTime @default(now())
  orders    Order[]
  tickets   SupportTicket[]
}

model Order {
  id        String  @id @default(cuid())
  ref       String  @unique
  /// numéro de facture séquentiel, figé à l'émission (art. 242 nonies A CGI)
  invoiceNumber Int? @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// livraison | emporter
  mode   String
  /// en_attente_paiement | confirmee | cuisine | route | livree | annulee
  status String @default("en_attente_paiement")

  /// Index de zone **ou** de palier de distance selon le mode de tarification
  /// en vigueur au moment de la commande (voir `delivery.mode`).
  zoneIdx Int?
  /// Distance routière retenue pour facturer, en km. `null` quand la commande a
  /// été tarifée par zone. Figée à la commande : elle justifie le montant
  /// facturé même si le barème change ensuite.
  distanceKm Float?
  slot    String @default("asap")

  customerName  String
  customerEmail String
  customerPhone String
  address       String?
  city          String?
  zip           String?

  subtotalCents Int
  discountCents Int @default(0)
  feeCents      Int @default(0)
  totalCents    Int
  /// TVA appliquée en points de base (1000 = 10 %), figée à la commande
  vatRateBp     Int @default(1000)

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promoCode   String?

  paid Boolean @default(false)
  /// en_attente | paye | echec | rembourse_partiel | rembourse | expire
  paymentStatus String @default("en_attente")
  paymentMethod String @default("Carte")

  /// Total déjà remboursé, en centimes. Cumulatif : plusieurs remboursements
  /// partiels s'additionnent, et la somme ne peut jamais dépasser `totalCents`.
  refundedCents Int @default(0)
  /// Numéro d'avoir séquentiel, figé à l'émission.
  ///
  /// Une facture émise ne se modifie ni ne s'efface (art. 242 nonies A CGI) :
  /// rembourser produit une **pièce distincte**, l'avoir, avec sa propre suite
  /// de numéros. Marquer la facture « remboursée » sans avoir ne justifierait
  /// aucune sortie d'argent devant un contrôle.
  creditNoteNumber Int? @unique
  refundedAt       DateTime?
  /// Motif du remboursement, repris sur l'avoir.
  refundReason     String    @default("")

  /// Code à quatre chiffres remis au client, qu'il donne au livreur.
  ///
  /// Preuve de remise : le livreur le saisit pour clore l'arrêt. Généré au
  /// départ en livraison et envoyé avec l'email « en route » — pas avant, un
  /// code communiqué trop tôt se perd dans la boîte de réception.
  deliveryCode       String?
  /// Livrée sans que le code ait pu être fourni — le motif est dans `driverNote`.
  deliveredWithoutCode Boolean @default(false)
  /// Ce que le livreur a signalé depuis la rue : client absent, adresse
  /// introuvable, code oublié.
  driverNote         String    @default("")
  incidentAt         DateTime?

  /// Annulation demandée par le client alors que la commande était déjà
  /// engagée en cuisine : elle attend une décision humaine, elle n'annule rien
  /// par elle-même.
  cancelRequestedAt DateTime?
  /// Ce que le client a écrit en demandant l'annulation.
  cancelReason      String    @default("")

  stripeSessionId       String?
  stripePaymentIntentId String?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  deliveryRunId String?
  deliveryRun   DeliveryRun? @relation(fields: [deliveryRunId], references: [id], onDelete: SetNull)
  runPosition   Int?

  /// JSON: OrderLine[] — figé à la commande (prix historiques)
  lines String

  /// horodatage de chaque étape, pour les délais réels du tableau de bord
  confirmedAt DateTime?
  cookingAt   DateTime?
  routeAt     DateTime?
  deliveredAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets SupportTicket[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([userId])
  @@index([stripeSessionId])
  @@index([paid, createdAt])
  @@index([deliveryRunId, runPosition])
}

// ─── Newsletter ───────────────────────────────────────────────

model NewsletterSubscriber {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  /// jeton de confirmation et de désinscription (RGPD)
  token String  @unique
  /// double opt-in : false jusqu'au clic dans l'email de confirmation
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  /// footer | checkout | admin | import
  source String @default("footer")

  createdAt DateTime @default(now())

  @@index([confirmed, unsubscribedAt])
}

model Campaign {
  id      String @id @default(cuid())
  subject String
  html    String
  /// tous | actifs | inactifs
  audience String @default("tous")
  /// brouillon | programmee | envoyee | echec
  status  String @default("brouillon")

  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Service après-vente ──────────────────────────────────────

model SupportTicket {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String
  subject       String
  /// retard | manquant | qualite | erreur_commande | remboursement | autre
  category      String  @default("autre")
  /// ouvert | en_cours | resolu | ferme
  status        String  @default("ouvert")
  /// basse | normale | haute
  priority      String  @default("normale")

  /// geste commercial accordé, en centimes
  refundCents Int?
  /// code promo de dédommagement généré depuis le ticket
  gestureCode String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  messages TicketMessage[]

  @@index([status, createdAt])
  @@index([customerEmail])
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// CLIENT | ADMIN
  author   String
  body     String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Messages du formulaire de contact public (distinct du SAV, sans commande).
model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String  @default("")
  message String
  handled Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

// ─── Traiteur (réunions & réceptions) ──────────────────────────

/// Demande de devis traiteur, déposée depuis la page publique `/traiteur`.
model CateringInquiry {
  id String @id @default(cuid())

  /// bureau | mariage | autre — correspond aux offres présentées en page Traiteur
  eventType     String
  eventDate     DateTime?
  guestCount    Int?
  location      String

  customerName  String
  customerPhone String
  customerEmail String
  message       String @default("")

  /// nouveau | contacte | devis_envoye | confirme | decline
  status String @default("nouveau")
  /// note interne, jamais montrée au client
  note   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ─── Contenu éditorial des pages vitrine ──────────────────────

/// Une section de page vitrine (accueil, à propos), ordonnable et modifiable
/// depuis le back-office.
///
/// Les textes, titres, photos et prix de ces pages étaient écrits en dur dans
/// les composants : la cliente ne pouvait ni corriger une faute, ni ajouter un
/// encart, ni masquer une section sans passer par un développeur. Chaque bloc
/// est désormais une ligne de cette table.
///
/// `kind` détermine la mise en page (le style maison reste garanti) et
/// `contentJson` porte ce qui est libre : titres, textes, photos, éléments.
/// Voir `lib/pageSections.ts` pour le catalogue des blocs et leur validation.
model PageSection {
  id String @id @default(cuid())

  /// accueil | a-propos — voir PAGES dans lib/pageSections.ts
  page String
  /// type de bloc — voir SECTION_KINDS dans lib/pageSections.ts
  kind String
  /// nom interne, affiché dans la liste du back-office uniquement
  label String @default("")

  position Int     @default(0)
  /// masquée = conservée en base mais absente du site public
  visible  Boolean @default(true)

  /// JSON: SectionContent (titres, textes, photos, éléments, prix…)
  contentJson String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, position])
}

// ─── Achats & budget ──────────────────────────────────────────

/// Ligne de la liste de courses prévisionnelle (achats de matières premières).
/// Le total de ligne (`qty × unitPriceCents`) n'est jamais stocké : toujours
/// recalculé, pour ne pas diverger si un prix grossiste change après coup.
model BudgetItem {
  id             String  @id @default(cuid())
  /// regroupement d'affichage, voir BUDGET_CATEGORIES dans lib/types.ts
  category       String
  label          String
  qty            Float   @default(1)
  /// unité affichée à côté de la quantité ("kg", "L", "plateau"…)
  unit           String  @default("")
  unitPriceCents Int
  /// emballages & à emporter : exclu du coût matière (alimentaire uniquement)
  packaging      Boolean @default(false)
  position       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, position])
}

// ─── Technique ────────────────────────────────────────────────

/// Réglages éditables depuis l'admin : coordonnées, SIRET, TVA, seuils, textes.
/// Évite de coder en dur ce que la cliente doit pouvoir changer seule.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Compteurs séquentiels (numérotation de facture, référence de commande).
/// Une numérotation de facture doit être chronologique et sans rupture.
model Counter {
  key   String @id
  value Int    @default(0)
}

/// Journal des emails envoyés : garantit l'idempotence quand Stripe rejoue un
/// webhook, et donne une trace de ce que le client a réellement reçu.
model EmailLog {
  id      String  @id @default(cuid())
  /// confirmation | paiement | statut | facture | relance | newsletter | sav
  kind    String
  orderId String?
  to      String
  /// clé d'unicité métier (ex. "paiement:<orderId>") pour ne pas envoyer 2 fois
  dedupeKey String? @unique
  ok        Boolean @default(true)
  error     String?

  sentAt DateTime @default(now())

  @@index([orderId])
  @@index([sentAt])
}
