# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.thumbnail

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local
# Copies de secours de `.env` faites à la main : même contenu sensible que
# l'original, aucune raison d'être versionnées.
.env.backup*

# Réglages Claude Code propres à la machine (chemins locaux, permissions).
# `settings.json` reste versionné : c'est la configuration de l'équipe.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# tests
/coverage

# déploiement
.vercel

# Sources et médias lourds — conservés sur le disque, hors du dépôt.
# `uploads/` contient les originaux fournis par la cliente (dépliant PDF, photos
# sources) : ne pas supprimer, c'est la seule copie. `assets/photos/` est un
# doublon de `public/photos/` (seul ce dernier est servi par le site).
/uploads
/scraps
/assets

# Maquettes de référence pré-Next (hors build, cf. tsconfig "exclude")
/_maquettes
