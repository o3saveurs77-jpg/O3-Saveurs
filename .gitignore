# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.thumbnail

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local
# Copies de secours de `.env` faites à la main : même contenu sensible que
# l'original, aucune raison d'être versionnées.
.env.backup*

# Réglages Claude Code propres à la machine (chemins locaux, permissions).
# `settings.json` reste versionné : c'est la configuration de l'équipe.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# tests
/coverage

# déploiement
.vercel
# Bloc de variables à coller dans la console Clever Cloud : mêmes secrets que
# `.env`, sous un autre nom. Une fois collé, ce fichier n'a plus de raison
# d'exister — le supprimer.
/clever-env.txt

# Vidage de pile laissé par Git Bash sous Windows — pas un artefact du projet.
bash.exe.stackdump

# La carte finale pèse 119 Mo : GitHub refuse tout fichier au-delà de 100 Mo, et
# ce poids vient d'un défaut d'export (couches superposées, cf. §13 de
# RECONCILIATION-CARTE.md). Elle reste sur le disque en attendant un export à
# plat, qui tiendra dans quelques mégaoctets et pourra, lui, être versionné.
/O3-Saveurs Carte-FINALE-corrigee.pdf
# Doublon exact de « O3-Saveurs Carte-mise-a-jour.pdf », déjà versionné.
/carte-o3-saveurs.pdf

# Sources et médias lourds — conservés sur le disque, hors du dépôt.
# `uploads/` contient les originaux fournis par la cliente (dépliant PDF, photos
# sources) : ne pas supprimer, c'est la seule copie. `assets/photos/` est un
# doublon de `public/photos/` (seul ce dernier est servi par le site).
/uploads
/scraps
/assets

# Maquettes de référence pré-Next (hors build, cf. tsconfig "exclude")
/_maquettes
