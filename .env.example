# Ô 3 Saveurs — variables d'environnement
# Copier en .env (dev) et renseigner les mêmes clés dans Vercel (Project Settings → Environment Variables).

# ─── Base de données PostgreSQL (Neon) ───
# DATABASE_URL = URL "pooled" (contient -pooler), utilisée par l'application.
# DIRECT_URL   = URL "direct" (sans -pooler), utilisée par les migrations Prisma.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (NextAuth / Auth.js + Auth0) ───
# Générer un secret : `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="remplacer-par-un-secret-aleatoire"
# URL publique du site (prod : https://o3saveurs.vercel.app). En dev laisser vide.
NEXTAUTH_URL="http://localhost:3000"
# Application Auth0 (Regular Web Application) — Dashboard → Applications →
# Basic Information. `AUTH0_ISSUER` = le Domain Auth0, préfixé par https://
# (ex. https://xxx.eu.auth0.com), sans slash final.
AUTH0_CLIENT_ID="remplacer"
AUTH0_CLIENT_SECRET="remplacer"
AUTH0_ISSUER="https://xxx.eu.auth0.com"
# Le rôle ADMIN ne se configure plus ici : il s'assigne dans Auth0
# (User Management → Users → Roles), voir auth0/actions/add-role-claim.js.
# Email du profil applicatif (nom, commandes) créé par `npm run db:seed`.
ADMIN_EMAIL="laila@o3saveurs.fr"

# ─── Stripe (paiement) ───
# Le paiement passe par Stripe Checkout **hébergé** : le client est redirigé vers
# une page Stripe. Aucune clé publique n'est donc nécessaire côté navigateur —
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY a été retirée, elle n'était lue par
# aucun fichier du projet.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Vercel Blob (upload photos de plats) ───
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── Resend (emails de confirmation & facture) ───
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="commandes@o3saveurs.fr"

# ─── Divers ───
# Email de notification de la restauratrice (reçoit les nouvelles commandes)
RESTAURANT_NOTIFY_EMAIL="laila@o3saveurs.fr"

# ─── Cron externe (relance panier abandonné) ───
# Secret partagé avec .github/workflows/abandoned-carts.yml (secret GitHub
# CRON_SECRET) : protège /api/cron/abandoned-carts, appelée sans session.
# Générer avec `openssl rand -base64 32`.
CRON_SECRET="remplacer-par-un-secret-aleatoire"

# ─── Google Maps (livraison au kilomètre) ───
# FACULTATIVE. Active la tarification à la distance routière : autocomplétion
# d'adresse (Places) + mesure du trajet (Distance Matrix). Sans elle, le site
# facture par zone de code postal — rien ne casse, le barème au km est
# simplement ignoré.
#
# Console Google Cloud → APIs & Services :
#   1. Activer « Places API » et « Distance Matrix API »
#   2. Credentials → Create credentials → API key
#   3. Restreindre la clé aux deux API ci-dessus (restriction « Application » :
#      aucune — la clé n'est utilisée que côté serveur, jamais par le navigateur)
#
# Une fois renseignée : Admin → Réglages → « Calcul des frais de livraison »
# → « Au kilomètre », puis régler les paliers dans Admin → Barème livraison.
GOOGLE_MAPS_API_KEY=""
