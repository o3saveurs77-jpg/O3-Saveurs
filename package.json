    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
